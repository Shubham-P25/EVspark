# ==========================================
# EVspark Environment Configuration Template
# ==========================================

# Database & Cache (PostgreSQL + PostGIS, Redis)
DATABASE_URL=
DIRECT_URL=
REDIS_URL=

# Clerk Authentication (Driver, Operator, Admin)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=

# Google Maps Platform (Driver Map, Places, Directions)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# Cloudinary (Station Photo Uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Internal Services & Networking
PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
ML_SERVICE_URL=http://localhost:8000

# Twin Engine Simulation Controls
SIM_SPEED_MULTIPLIER=1.0
FOCUS_STATION_IDS=
FOCUS_ARRIVAL_MIN_SEC=60
FOCUS_ARRIVAL_MAX_SEC=300

# Sentry Telemetry (Optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
